{
  "name": "vasak-terminal",
  "private": true,
  "version": "0.9.1",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bunx vue-tsc --noEmit && bunx --bun vite build",
    "preview": "bunx --bun vite preview",
    "tauri": "tauri",
    "lint": "bunx --bun biome check .",
    "lint:fix": "bunx --bun biome check --write . && bunx --bun biome format --write .",
    "format": "bunx --bun biome format --write ."
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tauri-apps/plugin-store": "^2.4.5",
    "@vasakgroup/plugin-config-manager": "~2.6.1",
    "@vasakgroup/plugin-vicons": "^2.2.1",
    "@vasakgroup/plugin-vsk-contextual-menu": "^2.0.2",
    "@vasakgroup/plugin-vsk-journal": "^2.0.0",
    "@vasakgroup/tauri-plugin-i18n": "^2.3.0",
    "@vasakgroup/vue-libvasak": "^1.9.0",
    "lodash.clonedeep": "^4.5.0",
    "path": "^0.12.7",
    "pinia": "^3.0.4",
    "url": "^0.11.4",
    "vue": "^3.5.43",
    "vue3-smooth-dnd": "^0.0.6",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@happy-dom/global-registrator": "^20.14.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.11.5",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/node": "^25.9.8",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/compiler-sfc": "^3.5.43",
    "@vue/test-utils": "^2.5.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vue-tsc": "^3.3.11"
  },
  "vasak": {
    "bibliotecasAtrasadas": {
      "@vasakgroup/plugin-config-manager": "La 2.7.0 declara pinia ^4 y esta aplicación está en pinia 3: subir el rango arrastra un salto mayor ajeno. Por eso el rango es ~2.6.1 y no ^2.6.1, que alcanzaría una versión que no se puede instalar. Se saca al subir a pinia 4."
    }
  }
}
